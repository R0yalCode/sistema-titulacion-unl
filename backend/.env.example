# Genera claves seguras (>=32 bytes) con: openssl rand -base64 32
# SECRET_KEY firma sesiones/CSRF/cookies de Django.
# JWT_SIGNING_KEY firma y verifica los JWT (access/refresh).
# Deben ser distintas entre si y nunca compartirse entre entornos (SEC-T004).
SECRET_KEY=change-me-in-dev
JWT_SIGNING_KEY=change-me-in-dev
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend

DB_ENGINE=django.db.backends.postgresql
DB_NAME=sgt_siaaf
DB_USER=sgt_user
DB_PASSWORD=change-me-in-dev
DB_HOST=localhost
DB_PORT=5432

# SEC-T008 / DEC-003 (aprobada 2026-11-05): límite de carga de documentos.
DOCUMENT_UPLOAD_THROTTLE=10/hour
# SEC-T002 / DEC-002 (aprobada 2026-11-05): límite de intentos de login.
# Solo es efectivo contra suplantación de IP una vez TRUSTED_PROXIES esté
# configurado correctamente (SEC-T005).
AUTH_THROTTLE_RATE=5/minute

# --- SEC-T001 (solo requeridas con DJANGO_SETTINGS_MODULE=config.settings.production) ---
# Dominio(s) real(es) donde se sirve el backend. Sin valor real aquí: cada
# entorno debe fijar el suyo, nunca inventado.
ALLOWED_HOSTS=
# Origen(es) HTTPS completos del frontend que envía peticiones mutantes
# (POST/PUT/PATCH/DELETE) con cookie CSRF. Ej: https://sgt-siaaf.unl.edu.ec
CSRF_TRUSTED_ORIGINS=
# Origen(es) HTTPS completos del frontend autorizados para CORS. Ej: https://sgt-siaaf.unl.edu.ec
CORS_ALLOWED_ORIGINS=
# Opcional: orígenes adicionales para connect-src de la CSP Report-Only
# (DEC-010), si la API y el frontend están en dominios distintos.
CSP_CONNECT_SRC_EXTRA=
# Opcional: rangos CIDR de proxies confiables para IP real (SEC-T005).
# Default si se omite: rangos privados RFC1918 (válido para Docker interno).
TRUSTED_PROXIES=
# Opcional: directorio de logs rotativos (SEC-T011). Default: /var/log/sgt-siaaf
# (creado y con permisos correctos en el target `production` del Dockerfile).
LOG_DIR=
