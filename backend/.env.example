# Genera claves seguras (>=32 bytes) con: openssl rand -base64 32
# SECRET_KEY firma sesiones/CSRF/cookies de Django.
# JWT_SIGNING_KEY firma y verifica los JWT (access/refresh).
# Deben ser distintas entre si y nunca compartirse entre entornos (SEC-T004).
SECRET_KEY=change-me-in-dev
JWT_SIGNING_KEY=change-me-in-dev
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend

DB_ENGINE=django.db.backends.postgresql
DB_NAME=sgt_siaaf
DB_USER=sgt_user
DB_PASSWORD=change-me-in-dev
DB_HOST=localhost
DB_PORT=5432

# SEC-T008 / DEC-003 (aprobada 2026-11-05): límite de carga de documentos.
DOCUMENT_UPLOAD_THROTTLE=10/hour
# SEC-T002 / DEC-002 (aprobada 2026-11-05): límite de intentos de login.
# Solo es efectivo contra suplantación de IP una vez TRUSTED_PROXIES esté
# configurado correctamente (SEC-T005).
AUTH_THROTTLE_RATE=5/minute
# AUTH-RC: recuperación de contraseña por correo.
# Límite por IP de solicitudes/validaciones/confirmaciones.
PASSWORD_RESET_THROTTLE_RATE=10/hour
# Vigencia del enlace en segundos.
PASSWORD_RESET_TIMEOUT=3600
# Origen público del frontend para construir el enlace del correo.
FRONTEND_BASE_URL=http://localhost:8000
# Sin SMTP configurado el correo se escribe en la consola del backend.
# Para envío real: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@unl.edu.ec
# Operaciones mutantes por usuario (VULN-001, INC-01-T01)
MUTANT_THROTTLE_RATE=30/minute

# --- SEC-T001 (solo requeridas con DJANGO_SETTINGS_MODULE=config.settings.production) ---
# Dominio(s) real(es) donde se sirve el backend. Sin valor real aquí: cada
# entorno debe fijar el suyo, nunca inventado.
ALLOWED_HOSTS=
# Origen(es) HTTPS completos del frontend que envía peticiones mutantes
# (POST/PUT/PATCH/DELETE) con cookie CSRF. Ej: https://sgt-siaaf.unl.edu.ec
CSRF_TRUSTED_ORIGINS=
# Origen(es) HTTPS completos del frontend autorizados para CORS. Ej: https://sgt-siaaf.unl.edu.ec
CORS_ALLOWED_ORIGINS=
# Opcional: orígenes adicionales para connect-src de la CSP Report-Only
# (DEC-010), si la API y el frontend están en dominios distintos.
CSP_CONNECT_SRC_EXTRA=
# Opcional: rangos CIDR de proxies confiables para IP real (SEC-T005).
# Default si se omite: rangos privados RFC1918 (válido para Docker interno).
TRUSTED_PROXIES=
# Opcional: directorio de logs rotativos (SEC-T011). Default: /var/log/sgt-siaaf
# (creado y con permisos correctos en el target `production` del Dockerfile).
LOG_DIR=

# Contraseña de las 8 cuentas demo que crea `manage.py seed_initial_data`.
# Obligatoria solo para ese comando, que se detiene si falta o está vacía.
# Sin valor por defecto: cada entorno de desarrollo define la suya.
# NUNCA en producción (C-012).
SEED_DEMO_PASSWORD=

# --- Autenticación en dos factores (TOTP / Google Authenticator) -------
# Ver docs/autenticacion/politica-2fa.md.
# Claves Fernet separadas por comas; la primera cifra y todas descifran.
# Obligatoria en producción. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# En desarrollo (config.settings.local) se deriva de SECRET_KEY si falta.
MFA_ENCRYPTION_KEYS=
MFA_ISSUER_NAME=SGT-SIAAF UNL
MFA_TOTP_VALID_WINDOW=1
MFA_CHALLENGE_TTL_SECONDS=300
MFA_CHALLENGE_MAX_ATTEMPTS=5
MFA_USER_MAX_FAILURES=10
MFA_USER_LOCKOUT_MINUTES=15
MFA_RECOVERY_CODES_COUNT=10
MFA_TRUSTED_DEVICE_DAYS=5
MFA_THROTTLE_RATE=10/minute
# Solo "local" está implementado; "cas" requiere autorización institucional.
AUTH_IDENTITY_PROVIDER=local
