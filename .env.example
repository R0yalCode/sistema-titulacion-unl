# Entorno de desarrollo (docker-compose.yml). Copie este archivo como `.env`.
# No versione `.env` ni reutilice estos valores en otros entornos.
# docker compose no arranca mientras las tres variables obligatorias estén vacías.

# Obligatorias
POSTGRES_PASSWORD=
SECRET_KEY=
JWT_SIGNING_KEY=

# Opcionales (se muestran los valores por defecto)
POSTGRES_DB=sgt_siaaf
POSTGRES_USER=sgt_user
DEBUG=1
