@startuml clases_dominio_sgt_siaaf
title Clases e interfaces relevantes del incremento — SGT-SIAAF (backend, Fase 1)

skinparam classAttributeIconSize 0
skinparam backgroundColor #ffffff
skinparam class {
    BackgroundColor #ffffff
    ArrowColor #2c3e50
    BorderColor #2c3e50
}

package "authentication" {
  class User {
    +id : UUID
    +username : str
    +email : str
    +is_active : bool
  }
  class Role {
    +id : int
    +codigo : str
  }
  class UserRole {
    +user_id : FK User
    +role_id : FK Role
    +carrera_id : str
  }
  class HasRolePermission {
    +has_permission(request, view) : bool
  }
  User "1" -- "0..*" UserRole
  Role "1" -- "0..*" UserRole
  HasRolePermission ..> User : verifica rol vía RBAC_MATRIX
}

package "expedientes" {
  class ExpedienteTitulacion {
    +id : UUID
    +numero_expediente : str
    +estudiante_id : FK User
    +carrera_id : str
    +estado : Enum
    +fecha_recepcion : datetime
    +fecha_limite_atencion : datetime
    +activo : bool
  }
  class HistorialEstado {
    +expediente_id : FK ExpedienteTitulacion
    +estado_anterior : str
    +estado_nuevo : str
    +timestamp : datetime
  }
  class PlazoLaboralCalculator <<domain service, puro>> {
    +calcular_fecha_limite(fecha_inicio, dias_habiles) : datetime
  }
  User "1" -- "0..*" ExpedienteTitulacion : estudiante
  ExpedienteTitulacion "1" -- "0..*" HistorialEstado
  ExpedienteTitulacion ..> PlazoLaboralCalculator : usa
}

package "peticiones" {
  class CatalogoDocumental {
    +id : bigint
    +codigo_requisito : str
    +nombre : str
  }
  class PeticionDocumental {
    +id : UUID
    +expediente_id : FK ExpedienteTitulacion
    +requisito_id : FK CatalogoDocumental
    +estado : Enum
    +dependencia_emisora : str
  }
  class DocumentoEntregado {
    +id : UUID
    +peticion_id : FK PeticionDocumental
    +version : int
    +hash_sha256 : str
    +es_vigente : bool
  }
  CatalogoDocumental "1" -- "0..*" PeticionDocumental
  ExpedienteTitulacion "1" -- "1..*" PeticionDocumental
  PeticionDocumental "1" -- "0..*" DocumentoEntregado
}

package "verificacion" {
  class ChecklistVerification {
    +id : UUID
    +peticion_id : FK PeticionDocumental
    +estado : Enum
    +revisor_id : FK User
  }
  class ObservacionAccionable {
    +id : UUID
    +expediente_id : FK ExpedienteTitulacion
    +peticion_id : FK PeticionDocumental
    +motivo_observacion : text
    +resuelta : bool
  }
  PeticionDocumental "1" -- "0..1" ChecklistVerification
  PeticionDocumental "1" -- "0..*" ObservacionAccionable
}

package "resoluciones" {
  class InformeAptitud {
    +id : UUID
    +expediente_id : FK ExpedienteTitulacion
    +numero_providencia : str
    +dictamen : str
  }
  class DeclaratoriaAptitud {
    +id : UUID
    +expediente_id : FK ExpedienteTitulacion
    +numero_memorando : str
    +decano_id : FK User
  }
  ExpedienteTitulacion "1" -- "0..1" InformeAptitud
  ExpedienteTitulacion "1" -- "0..1" DeclaratoriaAptitud
}

package "notificaciones" {
  class NotificacionInterna {
    +id : UUID
    +usuario_destino : FK User
    +expediente_id : FK ExpedienteTitulacion
    +leida : bool
  }
  class EventoAuditoria {
    +id : bigint
    +expediente_id : FK ExpedienteTitulacion
    +usuario_id : FK User
    +accion : str
    +detalles_json : JSONB
    +ip_origen : str
  }
  User "1" -- "0..*" NotificacionInterna
  ExpedienteTitulacion "1" -- "0..*" EventoAuditoria
}

package "core" <<módulo transversal>> {
  abstract class ISGALegacyPort <<interface, ABC>> {
    +{abstract} obtener_record_academico(estudiante_id) : RecordAcademicoSGA
    +{abstract} validar_matricula(estudiante_id) : bool
  }
  class SGAMockAdapter {
    +obtener_record_academico(estudiante_id) : RecordAcademicoSGA
    +validar_matricula(estudiante_id) : bool
  }
  class RecordAcademicoSGA <<dataclass>> {
    +promedio : Decimal
    +asignaturas : List~AsignaturaRecord~
  }
  class AsignaturaRecord <<dataclass>> {
    +nombre : str
    +nota : Decimal
  }
  SGAMockAdapter ..|> ISGALegacyPort
  ISGALegacyPort ..> RecordAcademicoSGA : retorna
  RecordAcademicoSGA "1" -- "0..*" AsignaturaRecord
}

ExpedienteTitulacion ..> ISGALegacyPort : consulta récord (vía servicio)

@enduml
